{
  "repo_id": "your-username/your-dataset",
  "repo_type": "dataset",
  "revision": "main",
  "token": "${HF_TOKEN}",
  "default_dir": "uploads",
  "private": true,
  "auto_create_repo": true,
  "max_concurrent_uploads": 4,
  "max_concurrent_commits": 2,
  "max_concurrent_downloads": 8,
  "max_file_size": 0,
  "temp_dir": null,
  "keep_temp": false,
  "encrypt_default_password": "123456",
  "api_key": "${HF_SERVER_API_KEY}",
  "allow_token_override": false,
  "allow_private_urls": false,
  "allowed_hosts": [],
  "cors_origins": [],
  "job_history_size": 500,
  "sse_interval": 1.0,
  "connect_timeout": 15.0,
  "read_timeout": 120.0,
  "download_retries": 3
}
